<script>
  const stages = document.querySelectorAll('.stage');
  const dotsEl = document.getElementById('dots');
  let cur = 0;
  stages.forEach((_,i)=>{
    const d = document.createElement('div');
    d.className = 'dot'+(i===0?' active':'');
    d.onclick = ()=>go(i);
    dotsEl.appendChild(d);
  });
  function go(n){
    stages[cur].classList.remove('active');
    dotsEl.children[cur].classList.remove('active');
    dotsEl.children[cur].classList.add('visited');
    cur=n;
    stages[cur].classList.add('active');
    dotsEl.children[cur].classList.remove('visited');
    dotsEl.children[cur].classList.add('active');
    document.getElementById('prev').disabled=cur===0;
    document.getElementById('next').disabled=cur===stages.length-1;
    document.getElementById('counter').textContent=(cur+1)+' of '+stages.length;
  }
  function move(d){go(Math.min(Math.max(cur+d,0),stages.length-1));}
</script>
